# Copie ce fichier en ".env" (même dossier que docker-compose.yml) et adapte-le.
# Dossier de la VM où le collecteur écrit 4heat_log.csv (y recopier le CSV existant pour garder l'historique)
HEATING_CSV_DIR=/chemin/vers/le/dossier/du/csv
# Module Wi-Fi 4HEAT interrogé par le collecteur
FOURHEAT_HOST=192.168.1.182
FOURHEAT_PORT=80
WEB_PORT=8000
# Adresse(s) par laquelle tu ouvres l'app, séparées par des virgules (ex. 10.0.0.5,chauffage.lan)
ALLOWED_HOSTS=*
# Obligatoire si tu passes par un nom de domaine / reverse proxy en https : https://chauffage.example
CSRF_TRUSTED_ORIGINS=
# Alertes Telegram (voir README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optionnel : base dédiée au lieu de SQLite (ex. postgres://user:pass@host:5432/chauffage)
DATABASE_URL=
